# PulseCare AI Frontend Environment Configuration (Vite)
# When deploying frontend on Vercel and backend on Render / Railway / Heroku / AWS:
# Set VITE_API_URL to your backend URL (e.g. https://your-healthcare-backend.onrender.com)
#
# NOTE: In Vite, all client-side environment variables MUST start with VITE_
# and are accessed via import.meta.env.VITE_*
VITE_API_URL=http://127.0.0.1:4000
